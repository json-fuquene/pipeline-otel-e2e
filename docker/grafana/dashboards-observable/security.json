          "id": "",
          "region": "us-east-1",
          "queryMode": "Logs",
          "logsMode": "Logs",
          "queryLanguage": "CWLI",
          "queryType": "range",
          "logGroupNames": [
            "/vpc/pipeline-otel-obs/flow-logs"
          ],
          "expression": "parse @message \"* * * * * * * * * * * * * * * * *\" as version, account, eni, srcaddr, dstaddr, srcport, dstport, protocol, packets, bytes, start, end, action, status, pkt_src, pkt_dst, direction | filter action = \"REJECT\" | stats count(*) as flows by srcaddr, dstport | sort flows desc | limit 15"
        }
      ],
