    {
      "id": 7,
      "type": "table",
      "title": "Top pares este-oeste (bytes)",
      "description": "",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "A",
          "id": "",
          "region": "us-east-1",
          "queryMode": "Logs",
          "logsMode": "Logs",
          "queryLanguage": "CWLI",
          "queryType": "range",
          "logGroupNames": [
            "/vpc/pipeline-otel-obs/flow-logs"
          ],
          "expression": "parse @message \"* * * * * * * * * * * * * * * * *\" as version, account, eni, srcaddr, dstaddr, srcport, dstport, protocol, packets, bytes, start, end, action, status, pkt_src, pkt_dst, direction | filter action = \"ACCEPT\" and isIpv4InSubnet(srcaddr, \"10.63.0.0/16\") and isIpv4InSubnet(dstaddr, \"10.63.0.0/16\") | stats sum(bytes) as total_bytes, count(*) as flows by srcaddr, dstaddr, dstport | sort total_bytes desc | limit 15"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
